# ---------- LLM ----------
LLM_PROVIDER=gemini                 # gemini | anthropic
GEMINI_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here
# MAIN_MODEL=gemini-2.5-flash       # model chính (planner, agent, trả lời)
# FAST_MODEL=gemini-2.5-flash-lite  # model rẻ (router, critic). Kiểm tra tên model mới nhất trong tài liệu nhà cung cấp.

# ---------- Embedding / Rerank ----------
EMBEDDING_PROVIDER=gemini           # hash (offline, chỉ để thử) | gemini | sentence-transformers
EMBEDDING_DIM=768                   # pgvector HNSW chỉ index được <= 2000 chiều
RERANKER=lexical                    # lexical (offline) | cross-encoder (bge-reranker-v2-m3) | none
# RERANK_THRESHOLD=0.3              # mặc định theo từng reranker; chỉnh bằng golden set

# ---------- Lưu trữ ----------
VECTOR_STORE=memory                 # memory | pgvector
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_rag

# ---------- Agent ----------
CRITIC_MODE=auto                    # auto (route agent/plan) | always | off
PARALLEL_STEPS=false                # true = chạy song song các bước độc lập (coi chừng rate limit free tier)
MAX_LLM_CALLS=30
MAX_TOOL_CALLS=16
MAX_TOTAL_TOKENS=80000
# ENABLE_WRITE_TOOLS=true           # bật tool ghi (cần xác nhận) - chỉ CLI
# TODAY=2026-12-20                  # ép ngày hiện tại cho demo
